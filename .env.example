# Copy this file to `.env` for machine-specific values. Never commit `.env`.
# Nested settings use two underscores: WHOOPY_<SECTION>__<FIELD>.

# WHOOPY_LLM__BACKEND=auto
# WHOOPY_TTS__BACKEND=auto
# WHOOPY_TTS__VOICE=af_heart
# WHOOPY_HARDWARE__PROFILE=auto
# WHOOPY_PIPELINE__CHECKPOINT_DIR=./runs
# WHOOPY_STORAGE__DB_URL=sqlite:///./whoopy.db
