# Copy this file to `.env` for machine-specific values. Never commit `.env`.
# Nested settings use two underscores: SERENITY_<SECTION>__<FIELD>.

# SERENITY_LLM__BACKEND=auto
# SERENITY_TTS__BACKEND=auto
# SERENITY_TTS__VOICE=af_heart
# SERENITY_HARDWARE__PROFILE=auto
# SERENITY_PIPELINE__CHECKPOINT_DIR=./runs
# SERENITY_STORAGE__DB_URL=sqlite:///./serenity.db
