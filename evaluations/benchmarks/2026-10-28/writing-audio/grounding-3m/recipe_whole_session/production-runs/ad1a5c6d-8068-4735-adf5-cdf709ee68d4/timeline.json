    },
    {
      "id": "speech-0005",
      "type": "SPEECH",
      "text": "When other thoughts arise, simply return to the sound again. There is no need to control anything—just notice and come back.",
      "delivery": "neutral",
      "intensity": "subtle",
      "language": "English",
      "voice_mode": "preset",
      "pace": "slow",
      "pronunciation_overrides": [],
