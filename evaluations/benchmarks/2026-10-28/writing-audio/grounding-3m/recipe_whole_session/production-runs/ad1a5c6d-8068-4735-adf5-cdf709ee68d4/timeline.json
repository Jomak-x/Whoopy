    },
    {
      "id": "speech-0004",
      "type": "SPEECH",
      "text": "Return your attention to that sound now. Let it ground you in this moment, steady and present. Notice how it connects you to the space around you.",
      "delivery": "neutral",
      "intensity": "subtle",
      "language": "English",
      "voice_mode": "preset",
