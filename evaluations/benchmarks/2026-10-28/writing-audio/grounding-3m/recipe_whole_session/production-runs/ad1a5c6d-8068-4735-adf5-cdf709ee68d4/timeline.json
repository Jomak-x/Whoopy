    },
    {
      "id": "speech-0003",
      "type": "SPEECH",
      "text": "Choose one familiar sound to return to, like the air conditioner or a clock’s soft tick. When your attention wanders, gently guide it back.",
      "delivery": "neutral",
      "intensity": "subtle",
      "language": "English",
      "voice_mode": "preset",
