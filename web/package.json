{
  "name": "whoopy-local-frontends",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:studio",
    "dev:studio": "npm --workspace @whoopy/studio run dev",
    "preview:studio": "npm --workspace @whoopy/studio run preview",
    "build": "npm run build:studio",
    "build:studio": "npm --workspace @whoopy/studio run build",
    "check": "npm run check:studio",
    "check:studio": "npm --workspace @whoopy/studio run check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
